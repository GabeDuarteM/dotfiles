#!/bin/bash

git rev-parse HEAD >/dev/null 2>&1 || { echo "Not a git repository." >&2; exit 1; }

if [[ -e $1 ]]; then
	git checkout "$@"
	exit
elif [[ "$1" = '-' ]]; then
	git checkout -
	exit
elif [[ "$1" = '-b' ]]; then
	git checkout "$@"
	exit
fi

branch=$(fzf-git-branch "$1")
fzf_status=$?
if [[ $fzf_status -ne 0 ]]; then
	exit $fzf_status
fi
if [[ -z "$branch" ]]; then
	echo "No branch selected."
	exit 1
fi

if [[ "$branch" = 'remotes/'* ]]; then
	git checkout --track "$branch"
else
	git checkout "$branch"
fi
