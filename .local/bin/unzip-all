#!/bin/bash

if [[ -z "$1" ]]; then
	echo "Usage: unzip-all <file>"
	exit 1
fi

file=$1
extension="${file##*.}"

case "$extension" in
zip)
	unzip "$file"
	;;
tar)
	tar -xvf "$file"
	;;
gz)
	tar -xvzf "$file"
	;;
bz2)
	tar -xvjf "$file"
	;;
xz)
	tar -xvJf "$file"
	;;
*)
	echo "Unsupported file extension: $extension"
	exit 1
	;;
esac
