#!/bin/bash

git rev-parse HEAD >/dev/null 2>&1 || { echo "Not a git repository." >&2; exit 1; }

selection=$(git branch --color=always --all --sort=-committerdate |
	grep -v HEAD |
	fzf --height 50% --ansi --no-multi --preview-window right:65% \
		--preview 'git log -n 50 --color=always --date=short --pretty="format:%C(auto)%cd %h%d %s" $(sed "s/.* //" <<< {})' \
		--query "!remote $1" \
		--select-1 \
		--exit-0)
fzf_status=$?
branch=$(sed "s/.* //" <<< "$selection")

if [[ $fzf_status -eq 130 ]]; then
	exit $fzf_status
fi

if [[ -z "$branch" ]]; then
	echo "No branches matched '!remote' filter; including remotes." >&2
	selection=$(git branch --color=always --all --sort=-committerdate |
		grep -v HEAD |
		fzf --height 50% --ansi --no-multi --preview-window right:65% \
			--preview 'git log -n 50 --color=always --date=short --pretty="format:%C(auto)%cd %h%d %s" $(sed "s/.* //" <<< {})' \
			--query "$1" \
			--select-1)
	fzf_status=$?
	branch=$(sed "s/.* //" <<< "$selection")

	if [[ $fzf_status -eq 130 ]]; then
		exit $fzf_status
	fi

	if [[ -z "$branch" ]]; then
		echo "No branches found even after including remotes." >&2
		exit 1
	fi
elif [[ $fzf_status -ne 0 ]]; then
	exit $fzf_status
fi

echo "$branch"
