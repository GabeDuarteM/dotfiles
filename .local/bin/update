#!/usr/bin/env bash
set -euo pipefail

refresh_mirrors_if_needed() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/update"
  local last_run_file="${state_dir}/cachyos-rate-mirrors-last-run"
  local now
  local last_run=0

  mkdir -p "${state_dir}"
  now="$(date +%s)"

  if [[ -f "${last_run_file}" ]]; then
    read -r last_run <"${last_run_file}"

    if [[ ! "${last_run}" =~ ^[0-9]+$ ]]; then
      last_run=0
    fi
  fi

  if ((now - last_run < 86400)); then
    return
  fi

  printf "\nRefreshing mirrors...\n"
  sudo cachyos-rate-mirrors
  printf "%s\n" "${now}" >"${last_run_file}"
}

refresh_mirrors_if_needed

printf "\nSyncing package databases...\n"
paru -Sy

printf "\nGetting list of packages to update...\n"
upgrades="$(paru -Quq)" || exit 1
aur_upgrades="$(paru -Qua 2>/dev/null || true)"

if [[ -z "${upgrades}" ]]; then
  printf "\nNo pacman or AUR upgrades.\n"
else
  printf "\nThe full package list is below:\n"
  printf "%s\n" "${upgrades}"
  printf "\nThere are %s packages to update.\n" "$(printf "%s\n" "${upgrades}" | wc -l | tr -d ' ')"
fi

if [[ -n "${aur_upgrades}" ]]; then
  printf "\nAUR packages that will be scanned by the paru pre-build hook:\n"
  printf "%s\n" "${aur_upgrades}"
fi

ignore=()

# Skip rebuilding quickshell-git unless caelestia is also being upgraded
if [[ -n "${upgrades}" ]]; then
  if printf "%s\n" "${upgrades}" | rg -qx 'quickshell-git' && ! printf "%s\n" "${upgrades}" | rg -q '^caelestia-'; then
    ignore+=(quickshell-git)
    printf "\nAuto ignoring quickshell-git because caelestia is not upgrading.\n"
  fi
fi

if [[ -n "${upgrades}" ]] && printf "%s\n" "${upgrades}" | rg -qx 'nvidia-utils'; then
  printf "\nNVIDIA drivers are scheduled to be updated. Continue? [Y/n] "
  read -r answer
  if [[ "${answer}" =~ ^[Nn]$ ]]; then
    printf "\nAborted.\n"
    exit 1
  fi
fi

printf "\nUpgrading packages...\n"
if ((${#ignore[@]})); then
  paru -Su --review --ignore "${ignore[@]}"
else
  paru -Su --review
fi

printf "\nUpdating flatpak packages...\n"
flatpak update -y

printf "\nRemoving unused flatpak packages...\n"
flatpak uninstall --unused -y

printf "\nDone.\n"
