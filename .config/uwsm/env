export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qtengine"
export QT_PLUGIN_PATH="/usr/lib/qt5/plugins"
export XDG_CONFIG_DIRS="$HOME/.config/kde-user-defaults:${XDG_CONFIG_DIRS:-/etc/xdg}"
# uwsm derives this from the desktop name, giving "hyprland-", but no
# hyprland-applications.menu exists. Without a menu file that resolves,
# kbuildsycoca6 builds an empty app list and Dolphin loses "Open With".
export XDG_MENU_PREFIX="arch-"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1
